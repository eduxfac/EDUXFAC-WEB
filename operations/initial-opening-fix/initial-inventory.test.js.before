import test from 'node:test';
import assert from 'node:assert/strict';
import ExcelJS from 'exceljs';
import {readFileSync} from 'node:fs';
import vm from 'node:vm';
import {initialTemplate,parseInitialWorkbook,INITIAL_COLUMNS,initialSummary,initialDate} from '../server/src/initial-inventory.js';
import {createFixture,ids} from './helpers/initial-inventory-fixture.js';
const base=()=>({codigo_interno:'INICIAL-001',nombre:'Producto inicial',unidad_medida:'UNIDAD',stock:120,stock_minimo:0,costo:1.57,precio:2,lote:'DFDF',vencimiento:'29/10/2026'});
async function book(items){const w=new ExcelJS.Workbook(),s=w.addWorksheet('Inventario inicial');s.addRow(INITIAL_COLUMNS.map(c=>c[1]));for(const r of items)s.addRow(INITIAL_COLUMNS.map(c=>r[c[0]]??null));return Buffer.from(await w.xlsx.writeBuffer()).toString('base64');}
test('Plantilla, parser y validaciones iniciales',async t=>{
 await t.test('15 columnas; Información, ejemplo dos lotes; sin máximo ni valor',async()=>{const w=new ExcelJS.Workbook();await w.xlsx.load(await initialTemplate());const s=w.getWorksheet('Inventario inicial');assert.deepEqual(s.getRow(1).values.slice(1),INITIAL_COLUMNS.map(c=>c[1]));assert.equal(s.rowCount,1);assert.ok(w.getWorksheet('Información'));assert.equal(s.getColumn(1).numFmt,'@');assert.equal(w.getWorksheet('Información').getRow(13).getCell(1).value,'P000003');});
 for(const n of [1,2,3])await t.test(n+' lote(s): un producto, costos y fechas separados',async()=>{const rows=Array.from({length:n},(_,i)=>({...base(),stock:50,costo:i?1.65:1.57,lote:'L'+i,vencimiento:i?'29/11/2026':'29/10/2026'}));const p=await parseInitialWorkbook(await book(rows)),s=initialSummary(p);assert.equal(s.errores,0);assert.equal(s.productos,1);assert.equal(s.lotes,n);assert.equal(s.stock_total,n*50);assert.equal(s.valor_total,n===1?78.5:n===2?161:243.5);});
 await t.test('sin lote ni vencimiento, costo obligatorio preservado',async()=>{const p=await parseInitialWorkbook(await book([{...base(),lote:'',vencimiento:''}]));assert.equal(p.rows[0].lote,'');assert.equal(p.rows[0].vencimiento,null);assert.equal(p.rows[0].costo,1.57);});
 for(const field of ['codigo_interno','nombre','unidad_medida','stock','stock_minimo','costo','precio'])await t.test(field+' vacío rechazado',async()=>{const p=await parseInitialWorkbook(await book([{...base(),[field]:''}]));assert.equal(initialSummary(p).errores,1);});
 for(const field of ['codigo_barras','principio_activo','concentracion','presentacion','categoria','laboratorio'])await t.test(field+' opcional vacío',async()=>assert.equal(initialSummary(await parseInitialWorkbook(await book([{...base(),[field]:''}]))).errores,0));
 await t.test('mínimo 0 permitido y precio/costo negativo rechazado',async()=>{assert.equal(initialSummary(await parseInitialWorkbook(await book([base()]))).errores,0);for(const f of ['stock','stock_minimo','costo','precio'])assert.equal(initialSummary(await parseInitialWorkbook(await book([{...base(),[f]:-1}]))).errores,1);});
 for(const field of ['nombre','unidad_medida','codigo_barras','principio_activo','concentracion','presentacion','categoria','laboratorio','stock_minimo','precio'])await t.test('código repetido con '+field+' diferente rechaza todas las filas',async()=>{const r={...base(),lote:'L2',[field]:field==='precio'?3:field==='stock_minimo'?1:field==='unidad_medida'?'CAJA':'Distinto'};const p=await parseInitialWorkbook(await book([base(),r]));assert.equal(initialSummary(p).errores,2);assert.match(p.rows[0].errors.join(),/filas 2, 3/);});
 await t.test('códigos distintos con barra/nombre duplicado rechazados; barra vacía no colisiona',async()=>{const a={...base(),codigo_barras:'00012345'},b={...base(),codigo_interno:'OTRO',nombre:'Otro',codigo_barras:'00012345'};assert.equal(initialSummary(await parseInitialWorkbook(await book([a,b]))).errores,2);assert.equal(initialSummary(await parseInitialWorkbook(await book([{...a,codigo_barras:''},{...b,codigo_barras:''}]))).errores,0);});
 await t.test('mismo lote con costo/vencimiento diferente rechazado; filas idénticas se suman',async()=>{assert.equal(initialSummary(await parseInitialWorkbook(await book([base(),{...base(),costo:2}]))).errores,2);const p=await parseInitialWorkbook(await book([base(),base()]));assert.equal(initialSummary(p).stock_total,240);assert.equal([...p.groups.values()][0].lots.get('DFDF').stock,240);});
 await t.test('fechas inválidas, fórmulas y unidades inválidas no se admiten',async()=>{for(const r of [{...base(),vencimiento:'31/02/2026'},{...base(),precio:{formula:'1+1',result:2}},{...base(),unidad_medida:'INVALIDA'}])assert.equal(initialSummary(await parseInitialWorkbook(await book([r]))).errores,1);assert.equal(initialDate(1),'1900-01-01');assert.equal(initialDate(1,true),'1904-01-02');});
 await t.test('5.000 filas, agrupación lineal sin consultas por fila',async()=>{const rows=Array.from({length:5000},(_,i)=>({...base(),codigo_interno:'ESCALA-'+i,nombre:'Producto escala '+i,stock:1}));const start=performance.now();const p=await parseInitialWorkbook(await book(rows));assert.equal(p.groups.size,5000);assert.equal(initialSummary(p).valor_total,7850);console.log('PERFORMANCE_PARSE_5000_MS='+Math.round(performance.now()-start));});
});
test('API y transacción PostgreSQL aislada',async t=>{
 const f=await createFixture();t.after(()=>f.close());const beforeB=await f.snapshotB();
 const request=(route,body,token=f.tokenA)=>f.request('/api/import/inventory/'+route,{method:'POST',token,body:{sucursal_id:ids.sucursalA,...body}});
 const counts=async()=> (await f.query('select (select count(*) from productos)::int products,(select count(*) from lotes)::int lots,(select count(*) from movimientos_inventario)::int movements,(select count(*) from compras)::int purchases,(select count(*) from precios_producto)::int prices')).rows[0];
 let seq=0;const fresh=()=>({...base(),codigo_interno:'TEST-'+(++seq),nombre:'Nuevo producto '+seq});
 async function run(rows){const file_base64=await book(rows),p=await request('preview',{file_base64});assert.equal(p.status,200,JSON.stringify(p.data));return{p,c:await request('commit',{file_base64,preview_sha256:p.data.sha256})};}
 await t.test('alta un producto, tres lotes, costo/fecha/stock/valor y auditoría inicial correctos',async()=>{const r=fresh(),rows=[{...r,stock:50},{...r,stock:50,costo:1.65,lote:'L2',vencimiento:'29/11/2026'},{...r,stock:10,costo:2,lote:'',vencimiento:''}],c0=await counts(),{c}=await run(rows);assert.equal(c.status,201,JSON.stringify(c.data));assert.equal(c.data.creados,1);assert.equal(c.data.lotes_creados,3);assert.equal(c.data.stock_total,110);assert.equal(c.data.valor_total,181);const ls=(await f.query('select l.* from lotes l join productos p on p.id=l.producto_id where p.codigo_interno=$1',[r.codigo_interno])).rows;assert.equal(ls.length,3);assert.equal(ls.reduce((n,l)=>n+Number(l.cantidad_disponible)*Number(l.costo_unitario),0),181);assert.ok(ls.some(l=>l.numero_lote===null&&l.fecha_vencimiento===null));const moves=(await f.query("select * from movimientos_inventario where referencia_id=$1",[c.data.batch_id])).rows;assert.equal(moves.length,3);assert.ok(moves.every(m=>m.tipo==='INVENTARIO_INICIAL'));assert.equal((await counts()).purchases,c0.purchases);});
 await t.test('no duplica una importación ya aplicada',async()=>{const r=fresh();assert.equal((await run([r])).c.status,201);const c0=await counts();assert.equal((await run([r])).c.status,400);assert.deepEqual(await counts(),c0);});
 await t.test('producto existente sin stock se vincula; maestros no se sobrescriben',async()=>{const r=fresh();await f.query('insert into productos(empresa_id,codigo_interno,nombre,unidad_medida) values($1,$2,$3,$4)',[ids.empresaA,r.codigo_interno,r.nombre,r.unidad_medida]);const{c}=await run([r]);assert.equal(c.status,201,JSON.stringify(c.data));assert.equal(c.data.creados,0);assert.equal(c.data.actualizados,1);});
 await t.test('errores en última fila cancelan todo, incluso API directa',async()=>{const c0=await counts(),r=fresh();assert.equal((await run([r,{...fresh(),costo:''}])).c.status,400);assert.deepEqual(await counts(),c0);});
 await t.test('fallo SQL después de escribir primer producto revierte maestros/precios/lotes/movimientos',async()=>{const c0=await counts();await f.query("CREATE FUNCTION initial_fail() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN IF NEW.numero_lote='FAIL-TEST' THEN RAISE EXCEPTION 'FAKE_TEST_FAILURE'; END IF; RETURN NEW; END $$; CREATE TRIGGER initial_failure BEFORE INSERT ON lotes FOR EACH ROW EXECUTE FUNCTION initial_fail()");try{assert.equal((await run([fresh(),{...fresh(),lote:'FAIL-TEST'}])).c.status,400);assert.deepEqual(await counts(),c0);}finally{await f.query('DROP TRIGGER initial_failure ON lotes; DROP FUNCTION initial_fail()');}});
 await t.test('archivo cambiado desde preview se rechaza',async()=>{const a=fresh(),file_base64=await book([a]),p=await request('preview',{file_base64});const c0=await counts();assert.equal((await request('commit',{file_base64:await book([{...a,stock:1}]),preview_sha256:p.data.sha256})).status,400);assert.deepEqual(await counts(),c0);});
 await t.test('barra existente en otro código no se duplica',async()=>{const r={...fresh(),codigo_barras:'0012345678'};assert.equal((await run([r])).c.status,201);assert.equal((await run([{...fresh(),codigo_barras:r.codigo_barras}])).c.status,400);});
 await t.test('empresa/sucursal ajena 403 sin escrituras; no autenticado 401',async()=>{const file_base64=await book([fresh()]);assert.equal((await request('preview',{file_base64,sucursal_id:ids.sucursalB})).status,403);assert.equal((await request('commit',{file_base64,sucursal_id:ids.sucursalB,preview_sha256:'fake'})).status,403);assert.equal((await request('preview',{file_base64},null)).status,401);assert.deepEqual(await f.snapshotB(),beforeB);});
 await t.test('rol se valida en sucursal exacta, no basta administrador en otra',async()=>{const cashier=(await f.query("select id from roles where nombre='Cajero / Vendedor'")).rows[0].id;await f.query('update usuario_sucursal set rol_id=$1 where usuario_id=$2 and sucursal_id=$3',[cashier,ids.usuarioA,ids.sucursalA2]);assert.equal((await request('preview',{file_base64:await book([fresh()]),sucursal_id:ids.sucursalA2})).status,403);});
});
test('Frontend: scripts compilables, flujo inicial y campos de plantilla exclusivos',()=>{
 const html=readFileSync(new URL('../public/index.html',import.meta.url),'utf8');
 for(const m of html.matchAll(/<script\b[^>]*>([\s\S]*?)<\/script>/gi))if(m[1].trim())new vm.Script(m[1]);
 assert.ok(!html.includes('id="inventoryImportMode"'));assert.ok(html.includes('preview_sha256:preview.sha256'));
 assert.ok(html.includes('Importación inicial de inventario desde Excel'));
});
